# Copy to .env.local and fill in real values.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed by scripts/migrate.cjs. New Supabase projects expose no direct
# host, so use the session pooler: aws-0-<region>.pooler.supabase.com
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ─── Cloudinary ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Claude (AI persona replies) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Admin ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_EMAIL=
ADMIN_SECRET_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Vercel sends this as a bearer token on cron invocations. Without it,
# /api/cron/sessions refuses to run rather than sitting open.
CRON_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
