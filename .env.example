# Copy to .env.local and fill in real values.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed by scripts/migrate.cjs. New Supabase projects expose no direct
# host, so use the session pooler: aws-0-<region>.pooler.supabase.com
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ─── Cloudinary ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Claude (AI persona replies) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Admin ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_EMAIL=
ADMIN_SECRET_KEY=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Vercel sends this as a bearer token on cron invocations. Without it,
# /api/cron/sessions refuses to run rather than sitting open.
CRON_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI (`stripe listen`) or a webhook endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=

# ─── Local payment methods (Phase 14) ────────────────────────────────────────
# All optional — each provider's routes return 503 until its own keys are set,
# so leaving these blank does not affect Stripe or anything else.

# Paystack — Nigeria, Ghana, South Africa, Kenya.
PAYSTACK_SECRET_KEY=

# Flutterwave — broader African coverage.
FLUTTERWAVE_SECRET_KEY=
# The static secret hash configured in the Flutterwave dashboard, echoed back
# on the verif-hash webhook header — not an HMAC, just a shared value to compare.
FLUTTERWAVE_WEBHOOK_HASH=

# M-Pesa (Safaricom Daraja) — Kenya, Tanzania, Uganda. Settles in KES only.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a real, publicly reachable HTTPS URL — Safaricom POSTs here directly,
# there is no signature to verify it, so keep this path unguessable.
MPESA_CALLBACK_URL=
# "production" to hit api.safaricom.co.ke instead of the sandbox host.
MPESA_ENV=

# Razorpay — India.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configured separately in the Razorpay dashboard's webhook settings, not the
# same secret as RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# Store and serve webinar video privately, behind URLs that expire.
#
# Off by default, and the default is deliberate. Signing only bites on assets
# stored as `authenticated`; a signed URL for a public asset is theatre,
# because the unsigned URL still works. So turning this on changes how videos
# are *stored*, and every video uploaded before the change keeps its public URL
# until it is re-uploaded or migrated through Cloudinary's `explicit` API.
#
# Turn it on, upload one video, and confirm it plays before relying on it.
CLOUDINARY_PRIVATE_VIDEOS=false
